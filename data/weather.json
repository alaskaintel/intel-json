        "event": "Wind Advisory",
        "headline": "Wind Advisory issued September 7 at 9:54AM AKDT until September 9 at 1:00AM AKDT by NWS Juneau AK",
        "description": "* WHAT...South winds 25 to 35 mph with gusts up to 50 mph expected.\n\n* WHERE...Municipality of Skagway.\n\n* WHEN...From 1 PM Tuesday to 1 AM AKDT Wednesday.\n\n* IMPACTS...Gusty winds will blow around unsecured objects. Tree\nlimbs could be blown down and a few power outages may result.\n\n* ADDITIONAL DETAILS...The strongest winds are expected in the\nafternoon hours with the initial frontal passage. A brief period of\ngusts in excess of 50 mph is possible during that timeframe.",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Juneau AK",
        "effective": "2026-09-07T09:54:00-08:00",
        "expires": "2026-09-07T18:00:00-08:00",
        "areas": "Municipality of Skagway",
        "category": "Met",
        "response": "Execute",
        "instruction": "Winds this strong can make travel difficult. Use extra caution.\n\nSecure outdoor objects.",
        "lat": null,
        "lng": null
      },
